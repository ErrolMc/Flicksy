<UserControl x:Class="Flicksy.VideoEditor.Controls.OverlayHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:drawing="clr-namespace:Flicksy.Drawing.Controls;assembly=Flicksy.Drawing">
    <!-- The ContentPresenter resolves the active overlay VM to its tile view by convention
         ({Name}ViewModel → {Name}View) via the shared ViewLocator below. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <drawing:ViewLocator x:Key="ViewLocator" />
    </UserControl.Resources>

    <!-- Dim layer over the whole window. Backdrop clicks light-dismiss (code-behind);
         the presenter marks tile clicks handled so they never reach the backdrop
         handler. Collapsed when no overlay is open, which also makes this control
         hit-test transparent (the UserControl itself has no background). -->
    <Grid Background="#AA000000"
          Visibility="{Binding IsOverlayOpen, Converter={StaticResource BoolToVis}}"
          MouseLeftButtonDown="OnBackdropMouseLeftButtonDown">
        <ContentPresenter HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Content="{Binding CurrentOverlay}"
                          ContentTemplateSelector="{StaticResource ViewLocator}"
                          MouseLeftButtonDown="OnTileMouseLeftButtonDown" />
    </Grid>
</UserControl>
