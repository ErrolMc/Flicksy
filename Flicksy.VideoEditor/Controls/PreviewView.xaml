<UserControl x:Class="Flicksy.VideoEditor.Controls.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flicksy.VideoEditor.Controls"
             xmlns:dctrls="clr-namespace:Flicksy.Drawing.Controls;assembly=Flicksy.Drawing"
             Background="#0A0A0A">
    <UserControl.Resources>
        <!-- Dark, compact ComboBox for the preview-quality selector (first ComboBox in the app).
             Not editable: a ToggleButton shows the selected label + a chevron and opens a dark
             popup of items. Palette mirrors TransportView's dark theme. -->
        <Style x:Key="PreviewComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0078D4" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewComboStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Background" Value="#CC2B2B2B" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PreviewComboItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Box"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <Path x:Name="Arrow"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,7,0"
                                                  Data="M0,0 L7,0 L3.5,4 Z"
                                                  Fill="#C8C8C8" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="Background" Value="#CC3A3A3A" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,22,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />

                            <Popup x:Name="Popup"
                                   Placement="Top"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide"
                                   Focusable="False">
                                <Border Background="#F2202020"
                                        BorderBrush="#66FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,0,2"
                                        MinWidth="{Binding ActualWidth, ElementName=ToggleButton}">
                                    <ScrollViewer>
                                        <ItemsPresenter SnapsToDevicePixels="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PreviewRoot" SizeChanged="OnPreviewSizeChanged">
        <Image Source="{Binding CurrentFrame}"
               Stretch="Uniform"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               SnapsToDevicePixels="True" />

        <!-- Graphics-editing overlay (#13 / ADR 0013): a project-resolution DrawingView Uniform-fit
             onto the Image's letterbox via OverlayScale/OverlayTranslate (computed in code-behind to
             match Stretch=Uniform). DataContext is the coordinator's ActiveOverlay; arming + style DPs
             come from GraphicsEditor on the root VM. Hit-test-transparent unless an edit session is open. -->
        <Canvas x:Name="OverlayContent"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="{Binding ProjectSettings.ResolutionWidth}"
                Height="{Binding ProjectSettings.ResolutionHeight}"
                RenderTransformOrigin="0,0"
                SizeChanged="OnPreviewSizeChanged">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="OverlayScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="OverlayTranslate" X="0" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>
            <!-- Sized from the host Canvas (NOT a local ProjectSettings binding — this control's
                 DataContext is the overlay VM, which has no ProjectSettings), mirroring how PostSnip
                 sizes its DrawingView from EditedImage.ActualWidth. A zero size would make the canvas
                 unhittable (TryGetPoint bails on ActualWidth <= 0). -->
            <dctrls:DrawingView Width="{Binding ElementName=OverlayContent, Path=ActualWidth}"
                                Height="{Binding ElementName=OverlayContent, Path=ActualHeight}"
                                DataContext="{Binding DataContext.GraphicsEditor.ActiveOverlay, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsSelectActive="{Binding DataContext.GraphicsEditor.IsSelectActive, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsShapeActive="{Binding DataContext.GraphicsEditor.IsShapeActive, RelativeSource={RelativeSource AncestorType=Window}}"
                                IsTextActive="{Binding DataContext.GraphicsEditor.IsTextActive, RelativeSource={RelativeSource AncestorType=Window}}"
                                ActiveShape="{Binding DataContext.GraphicsEditor.ShapeSettings.SelectedShape.Kind, RelativeSource={RelativeSource AncestorType=Window}}"
                                FillBrush="{Binding DataContext.GraphicsEditor.ShapeSettings.FillSettings.EffectiveBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                OutlineBrush="{Binding DataContext.GraphicsEditor.ShapeSettings.OutlineSettings.EffectiveBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                OutlineThickness="{Binding DataContext.GraphicsEditor.ShapeSettings.OutlineSettings.Size, RelativeSource={RelativeSource AncestorType=Window}}"
                                TextFontFamily="{Binding DataContext.GraphicsEditor.TextSettings.SelectedFont, RelativeSource={RelativeSource AncestorType=Window}}"
                                TextFontSize="{Binding DataContext.GraphicsEditor.TextSettings.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                TextFillBrush="{Binding DataContext.GraphicsEditor.TextSettings.FillSettings.EffectiveBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                TextOutlineBrush="{Binding DataContext.GraphicsEditor.TextSettings.OutlineSettings.EffectiveBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                TextOutlineThickness="{Binding DataContext.GraphicsEditor.TextSettings.OutlineSettings.Size, RelativeSource={RelativeSource AncestorType=Window}}"
                                ContentScale="{Binding ElementName=OverlayScale, Path=ScaleX}"
                                IsHitTestVisible="{Binding DataContext.GraphicsEditor.IsOverlayActive, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Canvas>
        <dctrls:SelectionOverlayView DataContext="{Binding DataContext.GraphicsEditor.SelectionOverlay, RelativeSource={RelativeSource AncestorType=Window}}"
                                     ContentToViewport="{Binding ElementName=OverlayContent, Path=RenderTransform}"
                                     IsHitTestVisible="{Binding DataContext.GraphicsEditor.IsOverlayActive, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Panel.ZIndex="5" />

        <!-- Performance stats HUD (top-left). Gated by VideoEditorSettings.ShowPerformanceStats via
             PreviewViewModel.PerformanceStats. -->
        <controls:PerformanceStatsView DataContext="{Binding PerformanceStats}"
                                       Panel.ZIndex="10"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Margin="10,10,0,0" />

        <!-- Preview-quality selector. View-only proxy setting (ADR 0008) — never affects export. -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Panel.ZIndex="10"
                Margin="0,0,10,10"
                Background="#99000000"
                CornerRadius="4"
                Padding="6,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Preview"
                           Foreground="#B0B0B0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ComboBox Style="{StaticResource PreviewComboStyle}"
                          Width="62"
                          Height="22"
                          ItemsSource="{Binding QualityOptions}"
                          SelectedValuePath="Quality"
                          SelectedValue="{Binding SelectedQuality, Mode=TwoWay}"
                          ToolTip="Preview resolution — lower is faster. Does not affect export." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
