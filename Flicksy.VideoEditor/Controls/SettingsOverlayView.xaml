<UserControl x:Class="Flicksy.VideoEditor.Controls.SettingsOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TileBackgroundBrush" Color="#242424" />
        <SolidColorBrush x:Key="TileBorderBrush" Color="#55FFFFFF" />
        <SolidColorBrush x:Key="SettingValueBrush" Color="#DDDDDD" />

        <!-- Dark checkbox matching the shell. Default WPF chrome is light, so the box +
             check are retemplated. -->
        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    CornerRadius="3"
                                    Background="#2B2B2B"
                                    BorderBrush="#55FFFFFF"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check"
                                      Visibility="Collapsed"
                                      Data="M 2,6 L 6,10 L 12,3"
                                      Stroke="#4DA3FF"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#4DA3FF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mirrors TransportView's TransportButtonStyle so dialog chrome matches the shell. -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{StaticResource SettingValueBrush}" />
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#222222" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Tile only — OverlayHost owns the dim backdrop, centering, and light-dismiss.
         DataContext is a SettingsOverlayViewModel (templated by OverlayHost). The
         performance-stats checkbox is a no-op placeholder bound to the VM's own flag;
         it drives nothing yet. -->
    <Border Width="380"
            Background="{StaticResource TileBackgroundBrush}"
            BorderBrush="{StaticResource TileBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="24,20">
        <StackPanel>
            <TextBlock Text="Settings"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold" />

            <Rectangle Height="1" Fill="#33FFFFFF" Margin="0,12,0,12" />

            <CheckBox Content="Show performance stats"
                      Style="{StaticResource DarkCheckBoxStyle}"
                      IsChecked="{Binding ShowPerformanceStats, Mode=TwoWay}" />

            <Rectangle Height="1" Fill="#33FFFFFF" Margin="0,12,0,12" />

            <Button x:Name="CloseButton"
                    Content="Close"
                    HorizontalAlignment="Right"
                    Style="{StaticResource DialogButtonStyle}"
                    Command="{Binding CloseCommand}" />
        </StackPanel>
    </Border>
</UserControl>
