<UserControl x:Class="Flicksy.VideoEditor.Controls.ConfirmDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="TileBackgroundBrush" Color="#242424" />
        <SolidColorBrush x:Key="TileBorderBrush" Color="#55FFFFFF" />
        <SolidColorBrush x:Key="SettingValueBrush" Color="#DDDDDD" />

        <!-- Mirrors the Settings / Project Settings tiles' DialogButtonStyle (itself a copy of
             TransportView's TransportButtonStyle) so dialog chrome matches the shell. -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{StaticResource SettingValueBrush}" />
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#222222" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Tile only — OverlayHost owns the dim backdrop, centering, and light-dismiss (backdrop click
         / Esc act as Cancel). DataContext is a ConfirmDialogViewModel (templated by OverlayHost).
         Header / Body / button labels are all bound so callers customise the whole prompt; the Cancel
         button collapses when HasCancel is false (single-button info / error acknowledgement). -->
    <Border Width="380"
            Background="{StaticResource TileBackgroundBrush}"
            BorderBrush="{StaticResource TileBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="24,20">
        <StackPanel>
            <TextBlock Text="{Binding Header}"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       TextWrapping="Wrap" />

            <Rectangle Height="1" Fill="#33FFFFFF" Margin="0,12,0,12" />

            <TextBlock Text="{Binding Body}"
                       Foreground="{StaticResource SettingValueBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="CancelButton"
                        Content="{Binding CancelLabel}"
                        Visibility="{Binding HasCancel, Converter={StaticResource BoolToVisibility}}"
                        Style="{StaticResource DialogButtonStyle}"
                        Command="{Binding CancelCommand}" />
                <Button x:Name="ConfirmButton"
                        Content="{Binding ConfirmLabel}"
                        Margin="8,0,0,0"
                        Style="{StaticResource DialogButtonStyle}"
                        Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
