<UserControl x:Class="Flicksy.VideoEditor.Controls.ProjectSettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TileBackgroundBrush" Color="#242424" />
        <SolidColorBrush x:Key="TileBorderBrush" Color="#55FFFFFF" />
        <SolidColorBrush x:Key="SettingLabelBrush" Color="#999999" />
        <SolidColorBrush x:Key="SettingValueBrush" Color="#DDDDDD" />

        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SettingLabelBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style x:Key="SettingValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SettingValueBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="24,4,0,4" />
        </Style>

        <!-- Mirrors TransportView's TransportButtonStyle so dialog chrome matches the shell. -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{StaticResource SettingValueBrush}" />
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#222222" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Tile only — OverlayHost owns the dim backdrop, centering, and light-dismiss.
         DataContext is a ProjectSettingsOverlayViewModel (templated by OverlayHost). -->
    <Border Width="380"
            Background="{StaticResource TileBackgroundBrush}"
            BorderBrush="{StaticResource TileBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="24,20">
        <StackPanel>
            <TextBlock Text="Project Settings"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold" />

            <Rectangle Height="1" Fill="#33FFFFFF" Margin="0,12,0,8" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Resolution" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource SettingValueStyle}"><Run Text="{Binding Settings.ResolutionWidth, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding Settings.ResolutionHeight, Mode=OneWay}" /></TextBlock>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Framerate" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource SettingValueStyle}"
                           Text="{Binding Settings.Framerate, StringFormat='{}{0} fps'}" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Style="{StaticResource SettingLabelStyle}"
                           Text="Audio sample rate" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Style="{StaticResource SettingValueStyle}"
                           Text="{Binding Settings.AudioSampleRate, StringFormat='{}{0} Hz'}" />
            </Grid>

            <Rectangle Height="1" Fill="#33FFFFFF" Margin="0,8,0,12" />

            <Button x:Name="CloseButton"
                    Content="Close"
                    HorizontalAlignment="Right"
                    Style="{StaticResource DialogButtonStyle}"
                    Command="{Binding CloseCommand}" />
        </StackPanel>
    </Border>
</UserControl>
