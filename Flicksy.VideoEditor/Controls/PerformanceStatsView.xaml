<UserControl x:Class="Flicksy.VideoEditor.Controls.PerformanceStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- HUD tile. Palette mirrors the preview-quality overlay it shares the surface with
         (#99000000 / #B0B0B0 labels / #E0E0E0 values, 11pt). IsHitTestVisible=False so it never
         steals a click from the preview. Visibility tracks PerformanceStatsViewModel.IsVisible,
         which mirrors the app-wide ShowPerformanceStats setting. -->
    <Border Background="#99000000"
            CornerRadius="4"
            Padding="8,5"
            IsHitTestVisible="False"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="FPS"
                       Foreground="#B0B0B0" FontSize="11" Margin="0,1,14,1" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FpsText}"
                       Foreground="#E0E0E0" FontSize="11" FontFamily="Consolas"
                       HorizontalAlignment="Right" Margin="0,1,0,1" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Frame"
                       Foreground="#B0B0B0" FontSize="11" Margin="0,1,14,1" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FrameTimeText}"
                       Foreground="#E0E0E0" FontSize="11" FontFamily="Consolas"
                       HorizontalAlignment="Right" Margin="0,1,0,1" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Dropped"
                       Foreground="#B0B0B0" FontSize="11" Margin="0,1,14,1" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DroppedText}"
                       Foreground="#E0E0E0" FontSize="11" FontFamily="Consolas"
                       HorizontalAlignment="Right" Margin="0,1,0,1" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Preview"
                       Foreground="#B0B0B0" FontSize="11" Margin="0,1,14,1" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ResolutionText}"
                       Foreground="#E0E0E0" FontSize="11" FontFamily="Consolas"
                       HorizontalAlignment="Right" Margin="0,1,0,1" />
        </Grid>
    </Border>
</UserControl>
