<UserControl x:Class="Flicksy.VideoEditor.Controls.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:timeline="clr-namespace:Flicksy.VideoEditor.Controls.Timeline"
             xmlns:proj="clr-namespace:Flicksy.VideoEditor.Project"
             Background="#161616">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TimelineRulerHeaderBg" Color="#1F1F1F" />
        <SolidColorBrush x:Key="TimelineRulerHeaderBorder" Color="#333333" />

        <!-- Dark menu chrome for the corner Add-track dropdown. WPF's default Menu/MenuItem
             chrome is light, so the header chip + popup items are retemplated dark, mirroring
             the title bar's MenuBarItemStyle / MenuPopupItemStyle (those are view-scoped to
             TitleBarView, hence the local copies). -->
        <Style x:Key="AddTrackHeaderStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="HeaderChip"
                                    Background="Transparent"
                                    CornerRadius="3"
                                    Padding="8,2">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   VerticalOffset="2"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="#242424"
                                        BorderBrush="#55FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        MinWidth="140">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="HeaderChip" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="HeaderChip" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddTrackItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemChip"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="10,6">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChip" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Pinned-headers layout: the header column lives in its own ScrollViewer outside
         the main horizontal scroll, so it stays put when the timeline pans right.
         Three ScrollViewers in total:
           - RulerScroller (row 0, col 1)  : H-slaved to MainScroller, no scrollbars shown
           - HeadersScroller (row 1, col 0): V-slaved to MainScroller, no scrollbars shown
           - MainScroller (row 1, col 1)   : the actual H+V scrolling for lanes
         Slave offsets are pushed by MainScroller's ScrollChanged. The slave scrollers
         carry small fixed margins to reserve gutter space matching MainScroller's H/V
         scrollbars so their content stays aligned with the lanes when scrollbars show.
         Wheel + click handlers attach to the outer Border so they fire anywhere on the
         timeline, regardless of which sub-scroller the cursor is over. -->
    <Border x:Name="RootBorder"
            Background="#161616"
            PreviewMouseWheel="OnRootPreviewMouseWheel">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- (0,0) Corner spacer above the headers column — hosts the Add-track dropdown.
                 A Menu (not a Button+ContextMenu) so its items live in the main visual tree and
                 bind straight to the TimelineViewModel's AddTrackCommand; the kind is passed as
                 the CommandParameter. -->
            <Border Grid.Row="0" Grid.Column="0"
                    Background="{StaticResource TimelineRulerHeaderBg}"
                    BorderBrush="{StaticResource TimelineRulerHeaderBorder}"
                    BorderThickness="0,0,1,1">
                <Menu Background="Transparent"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <MenuItem Header="+ Track"
                              ToolTip="Add a track"
                              Style="{StaticResource AddTrackHeaderStyle}">
                        <MenuItem Header="Video"
                                  Command="{Binding AddTrackCommand}"
                                  CommandParameter="{x:Static proj:TrackKind.Video}"
                                  Style="{StaticResource AddTrackItemStyle}" />
                        <MenuItem Header="Overlay"
                                  Command="{Binding AddTrackCommand}"
                                  CommandParameter="{x:Static proj:TrackKind.Overlay}"
                                  Style="{StaticResource AddTrackItemStyle}" />
                        <MenuItem Header="Audio"
                                  Command="{Binding AddTrackCommand}"
                                  CommandParameter="{x:Static proj:TrackKind.Audio}"
                                  Style="{StaticResource AddTrackItemStyle}" />
                    </MenuItem>
                </Menu>
            </Border>

            <!-- (0,1) Ruler. Right margin 12 reserves the gutter where MainScroller's
                 vertical scrollbar lives so ruler content lines up with lane content. -->
            <ScrollViewer x:Name="RulerScroller"
                          Grid.Row="0" Grid.Column="1"
                          Margin="0,0,12,0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Focusable="False">
                <timeline:TimeRulerView />
            </ScrollViewer>

            <!-- (1,0) Pinned headers. Bottom margin 12 reserves the gutter where
                 MainScroller's horizontal scrollbar lives. -->
            <ScrollViewer x:Name="HeadersScroller"
                          Grid.Row="1" Grid.Column="0"
                          Margin="0,0,0,12"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          Focusable="False">
                <ItemsControl ItemsSource="{Binding Project.Tracks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <timeline:TrackHeaderView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- (1,1) The scrollable lanes + playhead overlay. -->
            <ScrollViewer x:Name="MainScroller"
                          Grid.Row="1" Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ScrollChanged="OnMainScrollerScrollChanged"
                          Focusable="False">
                <!-- LanesHost is the scrolled content; pointer coords taken relative to it are
                     content space (X = frame × PixelsPerFrame, Y = lane stack). The interaction
                     layer's Preview handlers attach here so they tunnel ahead of ClipView.
                     MinWidth/MinHeight track the viewport so the host always covers the visible
                     area (a Grid in a ScrollViewer otherwise shrinks to its ~content size,
                     leaving empty space below the lanes unable to receive a deselect click). -->
                <Grid x:Name="LanesHost"
                      Background="Transparent"
                      MinWidth="{Binding ViewportWidth, ElementName=MainScroller}"
                      MinHeight="{Binding ViewportHeight, ElementName=MainScroller}"
                      PreviewMouseLeftButtonDown="OnLanesPreviewMouseLeftButtonDown"
                      PreviewMouseMove="OnLanesPreviewMouseMove"
                      PreviewMouseLeftButtonUp="OnLanesPreviewMouseLeftButtonUp">
                    <ItemsControl ItemsSource="{Binding Project.Tracks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <timeline:ClipsLaneView Track="{Binding}"
                                                        Timeline="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}">
                                    <timeline:ClipsLaneView.Style>
                                        <Style TargetType="{x:Type timeline:ClipsLaneView}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Disabled}" Value="True">
                                                    <Setter Property="Opacity" Value="0.35" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </timeline:ClipsLaneView.Style>
                                </timeline:ClipsLaneView>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <timeline:PlayheadView IsHitTestVisible="False" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
