<UserControl x:Class="Flicksy.VideoEditor.Controls.Panels.ShapesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#181818">
    <!-- DataContext stays the root VM (so the host's Visibility binding on CurrentLeftTab works);
         the body binds to the shared ShapeSettings via the inner DataContext below. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- One swatch (FillColorOption / OutlineColorOption — both expose Brush / IsNone / IsSelected). -->
        <DataTemplate x:Key="SwatchTemplate">
            <Button Width="22" Height="22" Margin="2" Cursor="Hand"
                    Command="{Binding DataContext.SelectColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Sw" CornerRadius="3" BorderThickness="2"
                                BorderBrush="#33FFFFFF" Background="{Binding Brush}" />
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsNone}" Value="True">
                                <Setter TargetName="Sw" Property="Background" Value="#2B2B2B" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Sw" Property="BorderBrush" Value="#0078D4" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer DataContext="{Binding GraphicsEditor.ShapeSettings}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="Shapes" Foreground="#E0E0E0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

            <ItemsControl ItemsSource="{Binding Shapes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="40" Height="40" Margin="3" Cursor="Hand"
                                ToolTip="{Binding Name}"
                                Command="{Binding DataContext.SelectShapeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Sh" CornerRadius="4" BorderThickness="2"
                                            BorderBrush="#00000000" Background="#242424" Padding="6">
                                        <Image Source="{Binding Icon}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Sh" Property="Background" Value="#303030" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Sh" Property="BorderBrush" Value="#0078D4" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Fill (hidden for Line / Arrow, which have no fill). -->
            <StackPanel Visibility="{Binding IsFillEnabled, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Fill" Foreground="#B0B0B0" FontSize="12" Margin="0,14,0,4" />
                <ItemsControl DataContext="{Binding FillSettings}" ItemsSource="{Binding Colors}"
                              ItemTemplate="{StaticResource SwatchTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="Outline" Foreground="#B0B0B0" FontSize="12" Margin="0,14,0,4" />
            <ItemsControl DataContext="{Binding OutlineSettings}" ItemsSource="{Binding Colors}"
                          ItemTemplate="{StaticResource SwatchTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Thickness" Foreground="#B0B0B0" FontSize="12" VerticalAlignment="Center" Width="64" />
                <Slider Width="120" VerticalAlignment="Center"
                        Minimum="{Binding OutlineSettings.MinSize}"
                        Maximum="{Binding OutlineSettings.MaxSize}"
                        Value="{Binding OutlineSettings.Size}" />
                <TextBlock Text="{Binding OutlineSettings.Size, StringFormat=0}" Foreground="#E0E0E0"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
