<UserControl x:Class="Flicksy.VideoEditor.Controls.TransportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#161616">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TransportBorderBrush" Color="#3DFFFFFF" />
        <SolidColorBrush x:Key="TransportTextBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="TimecodeTextBrush" Color="#BDBDBD" />

        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Foreground" Value="{StaticResource TransportTextBrush}" />
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#222222" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimecodeStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TimecodeTextBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Razor toggle: mirrors TransportButtonStyle but for a ToggleButton, with an accent
             highlight when checked so the active razor mode is visible at a glance. -->
        <Style x:Key="RazorToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Foreground" Value="{StaticResource TransportTextBrush}" />
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#0078D4" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#0078D4" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource TransportBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Edit tools + current position. Split / Razor act on the timeline selection, which
                 lives on the sibling TimelineViewModel — reached via the window's DataContext (this
                 view's own DataContext is the TransportViewModel). -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource TransportButtonStyle}"
                        Content="Split"
                        ToolTip="Split selected clips at the playhead (S)"
                        Command="{Binding DataContext.Timeline.SplitSelectedAtPlayheadCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                <ToggleButton Style="{StaticResource RazorToggleStyle}"
                              Content="Razor"
                              ToolTip="Razor: click a clip to cut it at that point (C)"
                              IsChecked="{Binding DataContext.Timeline.IsRazorMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource TimecodeStyle}"
                           Margin="12,0,0,0"
                           Text="{Binding CurrentTimecode}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource TransportButtonStyle}"
                        Content="Prev"
                        Command="{Binding PrevFrameCommand}" />
                <Button Style="{StaticResource TransportButtonStyle}"
                        MinWidth="72"
                        Content="{Binding PlayPauseLabel}"
                        Command="{Binding PlayPauseCommand}" />
                <Button Style="{StaticResource TransportButtonStyle}"
                        Content="Next"
                        Command="{Binding NextFrameCommand}" />
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Style="{StaticResource TimecodeStyle}"
                       HorizontalAlignment="Right"
                       Text="{Binding TotalTimecode}" />
        </Grid>
    </Border>
</UserControl>
