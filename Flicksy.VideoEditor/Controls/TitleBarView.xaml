<UserControl x:Class="Flicksy.VideoEditor.Controls.TitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#3DFFFFFF" />

        <!-- Caption buttons (Segoe MDL2 Assets chrome glyphs). The native buttons are
             gone with UseAeroCaptionButtons=False on the host window, so these substitute. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2D2D2D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#404040" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaximizeRestoreCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Content" Value="&#xE922;" />
            <Setter Property="ToolTip" Value="Maximize" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;" />
                    <Setter Property="ToolTip" Value="Restore" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#941F12" />
                                <Setter Property="Foreground" Value="#CCCCCC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu styles. WPF's default Menu/MenuItem chrome is light, so the bar
             headers + popup items are retemplated dark. PART_Popup is the name
             MenuItem's own logic looks up for submenu placement. -->
        <Style x:Key="MenuBarItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="HeaderChip"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    Padding="9,4">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   VerticalOffset="2"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="#242424"
                                        BorderBrush="#55FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        MinWidth="200">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="HeaderChip" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="HeaderChip" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuPopupItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemChip"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding InputGestureText}"
                                           Foreground="#888888"
                                           Margin="32,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChip" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemChip" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="#33FFFFFF" Margin="10,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- This strip is the host window's WindowChrome caption area (the window's
         CaptionHeight matches this control's Height). Interactive children must opt
         out of caption drag hit-testing via IsHitTestVisibleInChrome. -->
    <Grid Background="{StaticResource TitleBarBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Image x:Name="TitleBarIcon"
               Grid.Column="0"
               Width="16"
               Height="16"
               Margin="12,0,8,0"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <TextBlock Grid.Column="1"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                   Foreground="#CCCCCC"
                   FontSize="12"
                   VerticalAlignment="Center" />

        <!-- Undo/Redo drive the editor's shared UndoManager (TitleBarViewModel.History),
             auto-disabling with the stacks. The remaining commands are intentionally
             empty TitleBarViewModel placeholders; export / save / project settings /
             clipboard land later. -->
        <Menu Grid.Column="2"
              Margin="12,0,0,0"
              Background="Transparent"
              VerticalAlignment="Center"
              WindowChrome.IsHitTestVisibleInChrome="True">
            <MenuItem Header="_File" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="Export"
                          Command="{Binding ExportCommand}"
                          Style="{StaticResource MenuPopupItemStyle}" />
                <MenuItem Header="Save Project"
                          Command="{Binding SaveProjectCommand}"
                          Style="{StaticResource MenuPopupItemStyle}" />
                <MenuItem Header="Save Project As"
                          Command="{Binding SaveProjectAsCommand}"
                          Style="{StaticResource MenuPopupItemStyle}" />
                <MenuItem Header="Project Settings"
                          Command="{Binding ProjectSettingsCommand}"
                          Style="{StaticResource MenuPopupItemStyle}" />
            </MenuItem>
            <MenuItem Header="_Edit" Style="{StaticResource MenuBarItemStyle}">
                <MenuItem Header="Undo"
                          Command="{Binding History.UndoCommand}"
                          InputGestureText="Ctrl+Z"
                          Style="{StaticResource MenuPopupItemStyle}" />
                <MenuItem Header="Redo"
                          Command="{Binding History.RedoCommand}"
                          InputGestureText="Ctrl+Y"
                          Style="{StaticResource MenuPopupItemStyle}" />
                <Separator Style="{StaticResource MenuSeparatorStyle}" />
                <MenuItem Header="Copy"
                          Command="{Binding CopyCommand}"
                          Style="{StaticResource MenuPopupItemStyle}" />
                <MenuItem Header="Cut"
                          Command="{Binding CutCommand}"
                          Style="{StaticResource MenuPopupItemStyle}" />
                <MenuItem Header="Paste"
                          Command="{Binding PasteCommand}"
                          Style="{StaticResource MenuPopupItemStyle}" />
            </MenuItem>
        </Menu>

        <!-- Centered over the whole strip (ColumnSpan), not the spacer column, so it
             sits at the true window midpoint. ProjectName is shell state on the root
             VM, reached via the window's DataContext because this control's own
             DataContext is the TitleBarViewModel (same pattern as TransportView's
             Split/Razor bindings). Not hit-test-visible-in-chrome, so it stays part
             of the drag area. -->
        <TextBlock Grid.Column="0"
                   Grid.ColumnSpan="5"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Text="{Binding DataContext.ProjectName, RelativeSource={RelativeSource AncestorType=Window}}"
                   Foreground="White"
                   FontSize="12"
                   FontWeight="Bold" />

        <StackPanel Grid.Column="4" Orientation="Horizontal">
            <Button Style="{StaticResource CaptionButtonStyle}"
                    Content="&#xE921;"
                    ToolTip="Minimize"
                    Click="OnMinimizeButtonClick" />
            <Button Style="{StaticResource MaximizeRestoreCaptionButtonStyle}"
                    Click="OnMaximizeRestoreButtonClick" />
            <Button Style="{StaticResource CloseCaptionButtonStyle}"
                    Content="&#xE8BB;"
                    ToolTip="Close"
                    Click="OnCloseButtonClick" />
        </StackPanel>

        <Rectangle Grid.Column="0"
                   Grid.ColumnSpan="5"
                   Height="1"
                   VerticalAlignment="Bottom"
                   Fill="{StaticResource TitleBarBorderBrush}"
                   IsHitTestVisible="False" />
    </Grid>
</UserControl>
